# own installation with the extractors in tools/. A single hlbc_parse.py
# class dump is around 35 MB.
classes*.json
research/hlboot.*
research/extracted/
research/icons/
research/maps/*.png
research/maps/*.json
research/*.bin
research/*.tsv

